# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# Evennia runtime data (the game directory has its own .gitignore with more detail).
# The database holds accounts and password hashes; never commit it.
*.db3
# Patterns cover every game folder at the root, not just game/.
*/server/logs/*.log*
*/server/conf/secret_settings.py

# Editor / OS
# Shared VS Code setup is committed; anything else in .vscode/ stays local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
