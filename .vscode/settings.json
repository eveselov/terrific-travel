{
    // Use the ruff and mypy pinned in uv.lock (from .venv), not the copies bundled
    // with the extensions, so the editor agrees with `uv run ruff` / `uv run mypy`.
    "ruff.importStrategy": "fromEnvironment",
    "mypy-type-checker.importStrategy": "fromEnvironment",

    // Run mypy from the game folder that holds the file (the one with mypy.ini), so it checks
    // one game at a time. No daemon: it is shared by the workspace and would mix the games.
    "mypy-type-checker.cwd": "${nearestConfig}",
    "mypy-type-checker.preferDaemon": false,

    // Format with ruff and sort imports on every save.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
        }
    }
}
